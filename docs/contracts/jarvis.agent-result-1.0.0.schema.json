{
  "$defs": {
    "AgentResultStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "UNAVAILABLE",
        "INVALID_OUTPUT"
      ],
      "title": "AgentResultStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "jarvis.agent-result",
      "title": "Contract",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "invocation_id": {
      "format": "uuid",
      "title": "Invocation Id",
      "type": "string"
    },
    "node_run_id": {
      "format": "uuid",
      "title": "Node Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentResultStatus"
    },
    "requested_contract": {
      "pattern": "^[a-z0-9._-]+@[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Requested Contract",
      "type": "string"
    },
    "raw_output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Output"
    },
    "structured_output": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Structured Output"
    },
    "output_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Hash"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "invocation_id",
    "node_run_id",
    "status",
    "requested_contract",
    "started_at",
    "completed_at"
  ],
  "title": "AgentResult",
  "type": "object"
}