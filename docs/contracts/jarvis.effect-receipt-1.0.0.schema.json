{
  "$defs": {
    "ToolCallOutcome": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "OUTCOME_UNKNOWN"
      ],
      "title": "ToolCallOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "jarvis.effect-receipt",
      "title": "Contract",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "format": "uuid",
      "title": "Receipt Id",
      "type": "string"
    },
    "tool_call_id": {
      "format": "uuid",
      "title": "Tool Call Id",
      "type": "string"
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/ToolCallOutcome"
    },
    "previous_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Hash"
    },
    "resulting_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resulting Hash"
    },
    "verified": {
      "title": "Verified",
      "type": "boolean"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "receipt_id",
    "tool_call_id",
    "operation_id",
    "outcome",
    "verified",
    "observed_at",
    "evidence_refs"
  ],
  "title": "EffectReceipt",
  "type": "object"
}